    <!-- Hagia Sophia, event bonuses. The effect system has no "on religion spread" or "on unit
         trained" trigger, so both are built the way the narrative system counts events: the
         gossip log. Each run-once modifier fires when the owner's log holds at least N matching
         entries, so the first 8 conversions of the capital each start a Celebration and the
         first 12 units trained in the capital each add a Missionary there. -->
    <Modifier id="MOD_HAGIA_SOPHIA_CELEBRATION_1" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_GRANT_GOLDEN_AGE" run-once="true" permanent="true">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_WONDER_IS_ACTIVE">
                <Argument name="ConstructibleType">WONDER_HAGIA_SOPHIA</Argument>
            </Requirement>
            <Requirement type="REQUIREMENT_PLAYER_HAS_AT_LEAST_NUM_GOSSIPS">
                <Argument name="GossipTypes">GOSSIP_CONVERT_CITY01</Argument>
                <Argument name="GOSSIP_CONVERT_CITY01">Hash,IsCapital,True</Argument>
                <Argument name="Amount">1</Argument>
            </Requirement>
        </SubjectRequirements>
    </Modifier>
