<?xml version="1.0" encoding="utf-8"?>
<GameEffects xmlns="GameEffects">
    <Modifier id="MOD_REVEAL_CIV_CULTURE_TREE_BYZANTIUM" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_REVEAL_CULTURE_TREE">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_PLAYER_HAS_CIVILIZATION_OR_LEADER_TRAIT">
                <Argument name="TraitType">TRAIT_BYZANTIUM</Argument>
            </Requirement>
        </SubjectRequirements>
        <Argument name="ProgressionTreeType">TREE_CIVICS_EX_BYZANTIUM</Argument>
    </Modifier>
    <!-- Walls of Theodosius: twice the district health of ordinary walls. One modifier per player
         (a ConstructibleModifier would attach once per wall and stack). -->
    <Modifier id="MOD_BYZANTIUM_THEODOSIUS_WALLS_HEALTH" collection="COLLECTION_PLAYER_DISTRICTS" effect="EFFECT_DISTRICT_ADJUST_TOTAL_HEALTH">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_PLOT_HAS_CONSTRUCTIBLE">
                <Argument name="ConstructibleType">BUILDING_WALLS_THEODOSIUS</Argument>
                <Argument name="CurrentAgeOnly">false</Argument>
            </Requirement>
        </SubjectRequirements>
        <Argument name="Amount">100</Argument>
        <Argument name="Tooltip">LOC_BUILDING_WALLS_THEODOSIUS_NAME</Argument>
    </Modifier>
</GameEffects>
