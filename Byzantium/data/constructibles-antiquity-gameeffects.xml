    <Modifier id="MOD_BYZANTIUM_MESE_HAPPINESS_PER_SETTLEMENT_TOWN" collection="COLLECTION_ALL_CITIES" effect="EFFECT_CITY_ADJUST_YIELD_PER_NUM_CITIES">
