        <Row Tag="LOC_CIVIC_BYZANTIUM_THEMATA_NAME">
            <Text>Themata</Text>
        </Row>
        <Row Tag="LOC_CIVIC_BYZANTIUM_THEMATA_QUOTE">
            <Text>"The soldier should be feared by the enemy and loved by his own."</Text>
        </Row>
        <Row Tag="LOC_CIVIC_BYZANTIUM_THEMATA_AUTHOR">
            <Text>The Strategikon of Maurice</Text>
        </Row>
        <Row Tag="LOC_CIVIC_BYZANTIUM_PENTARCHY_NAME">
            <Text>Pentarchy</Text>
        </Row>
        <Row Tag="LOC_CIVIC_BYZANTIUM_PENTARCHY_QUOTE">
            <Text>"Solomon, I have outdone thee."</Text>
        </Row>
        <Row Tag="LOC_CIVIC_BYZANTIUM_PENTARCHY_AUTHOR">
            <Text>Justinian, at the dedication of the Hagia Sophia</Text>
        </Row>
