<?xml version="1.0" encoding="utf-8"?>
<!-- Shell (game setup) side of Byzantium. One Civilizations row per age domain: the picker only
     offers a civ in an age it has a row for (SetupParameters overrides PlayerCivilization's domain
     with Ages.PlayerCivilizationDomain). Exploration is the apex age; the Antiquity row is
     labelled "Byzantium (Time-Tested)" so it reads as an out-of-age option next to Rome, and the
     Modern row keeps a late start possible. The game side handles both through
     TRAIT_ANACHRONISTIC_CIV (base-standard/data/ages-post-process.sql). -->
<Database>
    <Civilizations>
        <Row Domain="AntiquityAgeCivilizations" CivilizationType="CIVILIZATION_BYZANTIUM" CivilizationName="LOC_CIVILIZATION_BYZANTIUM_TIME_TESTED_NAME" CivilizationFullName="LOC_CIVILIZATION_BYZANTIUM_TIME_TESTED_FULLNAME" CivilizationDescription="LOC_CIVILIZATION_BYZANTIUM_DESCRIPTION" CivilizationIcon="CIVILIZATION_BYZANTIUM" CivilizationIntroText="LOC_LOADING_CIV_INTRO_TEXT_BYZANTIUM"/>
        <Row Domain="ExplorationAgeCivilizations" CivilizationType="CIVILIZATION_BYZANTIUM" CivilizationName="LOC_CIVILIZATION_BYZANTIUM_NAME" CivilizationFullName="LOC_CIVILIZATION_BYZANTIUM_FULLNAME" CivilizationDescription="LOC_CIVILIZATION_BYZANTIUM_DESCRIPTION" CivilizationIcon="CIVILIZATION_BYZANTIUM" CivilizationIntroText="LOC_LOADING_CIV_INTRO_TEXT_BYZANTIUM"/>
        <Row Domain="ModernAgeCivilizations" CivilizationType="CIVILIZATION_BYZANTIUM" CivilizationName="LOC_CIVILIZATION_BYZANTIUM_NAME" CivilizationFullName="LOC_CIVILIZATION_BYZANTIUM_FULLNAME" CivilizationDescription="LOC_CIVILIZATION_BYZANTIUM_DESCRIPTION" CivilizationIcon="CIVILIZATION_BYZANTIUM" CivilizationIntroText="LOC_LOADING_CIV_INTRO_TEXT_BYZANTIUM"/>
