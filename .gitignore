# macOS
.DS_Store
._*

# Mod zips. release.sh no longer builds these; distribution is the repo itself.
# Kept so an old release.ps1 run or a stray archive cannot be committed by accident.
*.zip

# Orphaned Chromium/Edge profile directory. No script in this project uses it.
scratch/

# Screenshots
*.png

# Mod art is real content, not screenshots. Any mod folder's icons/ (including the alternate
# sets) and loading/ are kept, so a new civilization does not have to touch this file - which
# the Etruscans and Tuscany did have to, silently, until 2026-09-09.
!*/icons/*.png
!*/icons-*/*.png
!*/loading/*.png
# The untouched generations, kept so an icon can be re-cropped or re-rendered later.
!*/icons/src/*.png

# Python environment for the 3d_art pipeline. Recreate with the commands in 3d_art/README.md.
3d_art/.venv/
__pycache__/
*.pyc
*.blend1

# Reference renders of the custom models are art, not screenshots.
!3d_art/preview/*.png

