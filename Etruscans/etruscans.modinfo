<?xml version="1.0" encoding="utf-8"?>
<Mod id="etruscans" version="1" xmlns="ModInfo">
    <Properties>
        <Name>LOC_MODULE_ETRUSCANS_NAME</Name>
        <Description>LOC_MODULE_ETRUSCANS_DESCRIPTION</Description>
        <Authors>Marco</Authors>
        <Package>Mod</Package>
        <Version>1</Version>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
    </Dependencies>
    <References>
        <Mod id="age-antiquity" title="LOC_MODULE_AGE_ANTIQUITY_NAME"/>
    </References>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet></AlwaysMet>
        </Criteria>
        <Criteria id="antiquity-age-current">
            <AgeInUse>AGE_ANTIQUITY</AgeInUse>
        </Criteria>
        <Criteria id="exploration-age-current">
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
        </Criteria>
        <Criteria id="modern-age-current">
            <AgeInUse>AGE_MODERN</AgeInUse>
        </Criteria>
        <Criteria id="antiquity-age-persist" any="true">
            <AgeInUse>AGE_ANTIQUITY</AgeInUse>
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
            <AgeInUse>AGE_MODERN</AgeInUse>
        </Criteria>
        <Criteria id="tuscany-current">
            <ModInUse>tuscany</ModInUse>
        </Criteria>
        <Criteria id="tuscany-shell">
            <ModIsEnabled>tuscany</ModIsEnabled>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <!-- Icons are loose PNGs brought in with ImportFiles; the game and the shell each load them.
             The URL drops the folder and prefixes the mod id: fs://game/etruscans/<basename>. -->
        <ActionGroup id="etruscans-art" scope="game" criteria="always">
            <Actions>
                <ImportFiles>
                    <Item>icons/civ_sym_etruscans.png</Item>
                    <Item>icons/unitflag_biga.png</Item>
                    <Item>icons/unitflag_tyrrhenian_galley.png</Item>
                    <Item>icons/buildicon_cuniculus.png</Item>
                    <Item>icons/buildicon_tumulus.png</Item>
                    <Item>icons/wondericon_fanum_voltumnae.png</Item>
                    <Item>icons/leader_porsenna.png</Item>
                    <Item>icons/lp_hex_porsenna_256.png</Item>
                    <Item>icons/lp_hex_porsenna_128.png</Item>
                    <Item>icons/lp_hex_porsenna_64.png</Item>
                    <Item>icons/lp_circ_porsenna_256.png</Item>
                    <Item>icons/lp_circ_porsenna_140.png</Item>
                    <Item>icons/lp_circ_porsenna_128.png</Item>
                    <Item>icons/lp_circ_porsenna_64.png</Item>
                    <Item>icons/lsl_porsenna.png</Item>
                    <Item>icons/lsbg_etruscans_1080.png</Item>
                    <Item>icons/lsbg_etruscans_720.png</Item>
                    <Item>icons/lsbg_etruscans_vert.png</Item>
                    <Item>icons/bg-panel-etruscans.png</Item>
                    <Item>icons/bg-card-etruscans.png</Item>
                </ImportFiles>
                <UpdateIcons>
                    <Item>data/icons/icons.xml</Item>
                </UpdateIcons>
                <UpdateVisualRemaps>
                    <Item>data/visual-remaps.xml</Item>
                </UpdateVisualRemaps>
                <UIScripts>
                    <Item>ui/etruscans-images.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
        <ActionGroup id="etruscans-text" scope="game" criteria="always">
            <Actions>
                <UpdateText>
                    <Item>text/en_us/CitizenNamesText.xml</Item>
                    <Item>text/en_us/CityNamesText.xml</Item>
                    <Item>text/en_us/CivilizationLegacyText.xml</Item>
                    <Item>text/en_us/CivilizationText.xml</Item>
                    <Item>text/en_us/CivilopediaText.xml</Item>
                    <Item>text/en_us/ConstructibleText.xml</Item>
                    <Item>text/en_us/CultureText.xml</Item>
                    <Item>text/en_us/LeaderText.xml</Item>
                    <Item>text/en_us/LoadingText.xml</Item>
                    <Item>text/en_us/ModuleText.xml</Item>
                    <Item>text/en_us/UnitText.xml</Item>
                    <Item>text/en_us/UnlockText.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="etruscans-main" scope="game" criteria="always">
            <Actions>
                <UpdateDatabase>
                    <Item>data/civilizations-legacy.xml</Item>
                    <Item>data/civilizations-shared.xml</Item>
                    <Item>data/civilizations-shared-gameeffects.xml</Item>
                    <Item>data/leaders.xml</Item>
                    <Item>data/leaders-gameeffects.xml</Item>
                    <Item>data/traditions.xml</Item>
                    <Item>data/traditions-gameeffects.xml</Item>
                    <Item>data/unlocks-base-standard.xml</Item>
                    <Item>data/unlocks-antiquity.xml</Item>
                    <Item>data/unlocks-syncretism.xml</Item>
                    <Item>data/citizen-names.xml</Item>
                    <Item>data/loading-info.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="etruscans-antiquity" scope="game" criteria="antiquity-age-current">
            <Actions>
                <UpdateDatabase>
                    <Item>data/civilizations-antiquity.xml</Item>
                    <Item>data/civilizations-gameeffects.xml</Item>
                    <Item>data/narrative-display.xml</Item>
                    <Item>data/progression-trees-culture-unique.xml</Item>
                    <Item>data/units.xml</Item>
                    <Item>data/units-gameeffects.xml</Item>
                    <Item>data/progression-trees-tech.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="etruscans-exploration" scope="game" criteria="exploration-age-current">
            <Actions>
                <UpdateDatabase>
                    <Item>data/civilizations-exploration.xml</Item>
                    <Item>data/progression-trees-culture-unique-ex.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="etruscans-modern" scope="game" criteria="modern-age-current">
            <Actions>
                <UpdateDatabase>
                    <Item>data/civilizations-modern.xml</Item>
                    <Item>data/progression-trees-culture-unique-mo.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <!-- The quarter, the wonder and anything naming them: Antiquity buildings tagged AGELESS
             live on into the later ages, so this group covers all three. -->
        <ActionGroup id="etruscans-persist" scope="game" criteria="antiquity-age-persist">
            <Actions>
                <UpdateDatabase>
                    <Item>data/constructibles.xml</Item>
                    <Item>data/constructibles-gameeffects.xml</Item>
                    <Item>data/greatworks.xml</Item>
                    <Item>data/traditions-persist.xml</Item>
                    <Item>data/traditions-gameeffects-persist.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="etruscans-tuscany" scope="game" criteria="tuscany-current">
            <Properties>
                <LoadOrder>20</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/unlocks-tuscany.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="etruscans-shell" scope="shell" criteria="always">
            <Actions>
                <ImportFiles>
                    <Item>icons/civ_sym_etruscans.png</Item>
                    <Item>icons/unitflag_biga.png</Item>
                    <Item>icons/unitflag_tyrrhenian_galley.png</Item>
                    <Item>icons/buildicon_cuniculus.png</Item>
                    <Item>icons/buildicon_tumulus.png</Item>
                    <Item>icons/wondericon_fanum_voltumnae.png</Item>
                    <Item>icons/leader_porsenna.png</Item>
                    <Item>icons/lp_hex_porsenna_256.png</Item>
                    <Item>icons/lp_hex_porsenna_128.png</Item>
                    <Item>icons/lp_hex_porsenna_64.png</Item>
                    <Item>icons/lp_circ_porsenna_256.png</Item>
                    <Item>icons/lp_circ_porsenna_140.png</Item>
                    <Item>icons/lp_circ_porsenna_128.png</Item>
                    <Item>icons/lp_circ_porsenna_64.png</Item>
                    <Item>icons/lsl_porsenna.png</Item>
                    <Item>icons/lsbg_etruscans_1080.png</Item>
                    <Item>icons/lsbg_etruscans_720.png</Item>
                    <Item>icons/lsbg_etruscans_vert.png</Item>
                    <Item>icons/bg-panel-etruscans.png</Item>
                    <Item>icons/bg-card-etruscans.png</Item>
                </ImportFiles>
                <UpdateIcons>
                    <Item>data/icons/icons.xml</Item>
                </UpdateIcons>
                <UpdateVisualRemaps>
                    <Item>data/visual-remaps.xml</Item>
                </UpdateVisualRemaps>
                <UIScripts>
                    <Item>ui/etruscans-images.js</Item>
                </UIScripts>
                <UpdateDatabase>
                    <Item>config/config.xml</Item>
                    <Item>config/config-leader.xml</Item>
                    <Item>config/config-traditions.xml</Item>
                    <Item>data/unlocks-syncretism.xml</Item>
                </UpdateDatabase>
                <UpdateText>
                    <Item>text/en_us/CivilizationLegacyText.xml</Item>
                    <Item>text/en_us/CivilizationText.xml</Item>
                    <Item>text/en_us/ConstructibleText.xml</Item>
                    <Item>text/en_us/CultureText.xml</Item>
                    <Item>text/en_us/LeaderText.xml</Item>
                    <Item>text/en_us/LoadingText.xml</Item>
                    <Item>text/en_us/ModuleText.xml</Item>
                    <Item>text/en_us/UnitText.xml</Item>
                    <Item>text/en_us/UnlockText.xml</Item>
                    <Item>text/en_us/CivilopediaText.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="etruscans-shell-tuscany" scope="shell" criteria="tuscany-shell">
            <Properties>
                <LoadOrder>20</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>config/config-tuscany.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
    </ActionGroups>
    <LocalizedText>
        <File>text/en_us/ModuleText.xml</File>
    </LocalizedText>
</Mod>
