<Database>
    <EnglishText>
        <Row Tag="LOC_TREE_CIVICS_AQ_ETRUSCANS_NAME">
            <Text>Etruscan Traditions</Text>
        </Row>
        <Row Tag="LOC_CIVIC_ETRUSCANS_CUNICULI_NAME">
            <Text>Cuniculi</Text>
        </Row>
        <Row Tag="LOC_CIVIC_ETRUSCANS_CUNICULI_QUOTE">
            <Text>They cut channels through the living rock to carry the water off the fields, and the fields answered.</Text>
        </Row>
        <Row Tag="LOC_CIVIC_ETRUSCANS_CUNICULI_AUTHOR">
            <Text>Etruscan proverb, as the Romans reported it</Text>
        </Row>
        <Row Tag="LOC_CIVIC_ETRUSCANS_DODECAPOLIS_NAME">
            <Text>Dodecapolis</Text>
        </Row>
        <Row Tag="LOC_CIVIC_ETRUSCANS_DODECAPOLIS_QUOTE">
            <Text>Twelve peoples, one shrine, one spring festival, one voice.</Text>
        </Row>
        <Row Tag="LOC_CIVIC_ETRUSCANS_DODECAPOLIS_AUTHOR">
            <Text>On the League of the Twelve</Text>
        </Row>
        <Row Tag="LOC_CIVIC_ETRUSCANS_HARUSPICINA_NAME">
            <Text>Haruspicina</Text>
        </Row>
        <Row Tag="LOC_CIVIC_ETRUSCANS_HARUSPICINA_QUOTE">
            <Text>The sky is divided into sixteen regions, and every one of them has an owner.</Text>
        </Row>
        <Row Tag="LOC_CIVIC_ETRUSCANS_HARUSPICINA_AUTHOR">
            <Text>From the libri fulgurales</Text>
        </Row>
        <Row Tag="LOC_NODE_CIVIC_EX_ETRUSCANS_SURVIVAL_NAME">
            <Text>Etruscan Survivals</Text>
        </Row>
        <Row Tag="LOC_NODE_CIVIC_MO_ETRUSCANS_REVIVAL_NAME">
            <Text>Etruscan Revival</Text>
        </Row>
