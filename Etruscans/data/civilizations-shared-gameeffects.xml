<?xml version="1.0" encoding="utf-8"?>
<GameEffects xmlns="GameEffects">
    <!-- Disciplina Etrusca. The libri rituales told an Etruscan how to found a city, drain its
         valley and orient its temples; the tomb paintings show what the result was for. -->
    <Modifier id="MOD_ETRUSCANS_SETTLEMENT_PRODUCTION" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_PRODUCTION</Argument>
        <Argument name="Amount">1</Argument>
        <Argument name="Tooltip">LOC_TRAIT_ETRUSCANS_ABILITY_NAME</Argument>
    </Modifier>
    <Modifier id="MOD_ETRUSCANS_SETTLEMENT_HAPPINESS" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_HAPPINESS</Argument>
        <Argument name="Amount">2</Argument>
        <Argument name="Tooltip">LOC_TRAIT_ETRUSCANS_ABILITY_NAME</Argument>
    </Modifier>
    <!-- The engineering half: buildings go up faster (the shape base civs use for unit production,
         applied to constructibles). -->
    <Modifier id="MOD_ETRUSCANS_BUILDING_PRODUCTION" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_CONSTRUCTIBLE_PRODUCTION">
        <Argument name="ConstructibleClass">BUILDING</Argument>
        <Argument name="Percent">15</Argument>
        <Argument name="Tooltip">LOC_TRAIT_ETRUSCANS_ABILITY_NAME</Argument>
        <String context="Preview">LOC_TRAIT_ETRUSCANS_ABILITY_PREVIEW</String>
    </Modifier>
</GameEffects>
