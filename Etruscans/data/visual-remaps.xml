<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Custom types borrow the models of shipped ones. From = our type, To = the type whose art is
     shown. Remaps are keyed by ID and each is a toggle in the game's Options screen.
     Units and wonders only: `To` has to name something that exists in the art data, and unit
     and wonder assets are named after their type (UNIT_CHARIOT, WONDER_ORACLE) while buildings
     are not - a building's art is picked by a rule in BIN_Hero_Building_Footprint keyed on
     [BUILDING:<type>], so a remap has nothing to point at. The Cuniculus and the Tumulus get
     their models from that table instead, in dlc/civart.json. -->
<Database>
    <VisualRemaps>
        <Row>
            <ID>REMAP_ETRUSCANS_BIGA</ID>
            <DisplayName>LOC_REMAP_ETRUSCANS_BIGA</DisplayName>
            <Kind>UNIT</Kind>
            <From>UNIT_BIGA</From>
            <To>UNIT_CHARIOT</To>
        </Row>
        <Row>
            <ID>REMAP_ETRUSCANS_TYRRHENIAN_GALLEY</ID>
            <DisplayName>LOC_REMAP_ETRUSCANS_TYRRHENIAN_GALLEY</DisplayName>
            <Kind>UNIT</Kind>
            <From>UNIT_TYRRHENIAN_GALLEY</From>
            <To>UNIT_GALLEY</To>
        </Row>
        <Row>
            <ID>REMAP_ETRUSCANS_FANUM_VOLTUMNAE</ID>
            <DisplayName>LOC_REMAP_ETRUSCANS_FANUM_VOLTUMNAE</DisplayName>
            <Kind>BUILDING</Kind>
            <From>WONDER_FANUM_VOLTUMNAE</From>
            <To>WONDER_ORACLE</To>
        </Row>
    </VisualRemaps>
</Database>
