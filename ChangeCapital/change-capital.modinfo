<?xml version="1.0" encoding="utf-8"?>
<Mod id="change-capital" version="1" xmlns="ModInfo">
    <Properties>
        <Name>LOC_MODULE_CHANGE_CAPITAL_NAME</Name>
        <Description>LOC_MODULE_CHANGE_CAPITAL_DESCRIPTION</Description>
        <Authors>Marco</Authors>
        <Package>Mod</Package>
        <Version>1</Version>
        <!-- No changes that would make a save depend on this mod's own database rows (only a
             UI script, a file override, and one icon definition): this must be set so the game
             still loads it into a save that was started before this mod was installed. -->
        <AffectsSavedGames>0</AffectsSavedGames>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet></AlwaysMet>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="change-capital-main" scope="game" criteria="always">
            <Actions>
                <UIScripts>
                    <Item>ui/change-capital-transition.js</Item>
                </UIScripts>
                <UpdateText>
                    <Item>text/en_us/ModuleText.xml</Item>
                    <Item>text/en_us/ChangeCapitalText.xml</Item>
                    <Item locale="de_DE">l10n/de_DE_Text.xml</Item>
                    <Item locale="es_ES">l10n/es_ES_Text.xml</Item>
                    <Item locale="fr_FR">l10n/fr_FR_Text.xml</Item>
                    <Item locale="it_IT">l10n/it_IT_Text.xml</Item>
                    <Item locale="ja_JP">l10n/ja_JP_Text.xml</Item>
                    <Item locale="ko_KR">l10n/ko_KR_Text.xml</Item>
                    <Item locale="pl_PL">l10n/pl_PL_Text.xml</Item>
                    <Item locale="pt_BR">l10n/pt_BR_Text.xml</Item>
                    <Item locale="uk_UA">l10n/uk_UA_Text.xml</Item>
                    <Item locale="zh_Hans_CN">l10n/zh_Hans_CN_Text.xml</Item>
                    <Item locale="zh_Hant_HK">l10n/zh_Hant_HK_Text.xml</Item>
                </UpdateText>
                <UpdateIcons>
                    <Item>data/icons.xml</Item>
                </UpdateIcons>
            </Actions>
        </ActionGroup>
        <!-- The shell (mod browser, before a game exists) needs its own copy of the module
             name/description text so "Additional Content" shows a localized name/description
             instead of the raw LOC_ tag - matching Byzantium's ModuleText.xml being loaded under
             both its game and shell ActionGroups. -->
        <ActionGroup id="change-capital-shell" scope="shell" criteria="always">
            <Actions>
                <UpdateText>
                    <Item>text/en_us/ModuleText.xml</Item>
                    <Item>l10n/ModuleText.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <!-- Same-path file override (see the comment at the top of the shipped file): this mod
             ships its own copy of production-chooser-helpers.js, based on the copy the
             MovableBuildings mod already ships, so a "Make Capital" project row appears in the
             production/purchase chooser the same way Move Building's own entry does. A higher
             LoadOrder than MovableBuildings' (1666) makes ours the one the game actually loads
             if both are present; either way only one same-path file can win, which is an
             inherent limitation of this technique, not something a LoadOrder fully solves for
             every possible combination of mods. -->
        <ActionGroup id="change-capital-production-chooser" scope="game" criteria="always">
            <Properties>
                <LoadOrder>1700</LoadOrder>
            </Properties>
            <Actions>
                <ImportFiles>
                    <Item>base-standard/ui/production-chooser/production-chooser-helpers.js</Item>
                </ImportFiles>
            </Actions>
        </ActionGroup>
    </ActionGroups>
    <LocalizedText>
        <File>text/en_us/ModuleText.xml</File>
    </LocalizedText>
</Mod>
