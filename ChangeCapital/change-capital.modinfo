<?xml version="1.0" encoding="utf-8"?>
<Mod id="change-capital" version="1" xmlns="ModInfo">
    <Properties>
        <Name>LOC_MODULE_CHANGE_CAPITAL_NAME</Name>
        <Description>LOC_MODULE_CHANGE_CAPITAL_DESCRIPTION</Description>
        <Authors>Marco</Authors>
        <Package>Mod</Package>
        <Version>1</Version>
        <!-- Pure UI mod, no UpdateDatabase: this must be set so the game still loads it into
             a save that was started before this mod was installed. -->
        <AffectsSavedGames>0</AffectsSavedGames>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet></AlwaysMet>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="change-capital-main" scope="game" criteria="always">
            <Actions>
                <UIScripts>
                    <Item>ui/change-capital-transition.js</Item>
                    <Item>ui/change-capital-relocate.js</Item>
                </UIScripts>
                <UpdateText>
                    <Item>text/en_us/ModuleText.xml</Item>
                    <Item>text/en_us/ChangeCapitalText.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
    </ActionGroups>
    <LocalizedText>
        <File>text/en_us/ModuleText.xml</File>
    </LocalizedText>
</Mod>
