<?xml version="1.0" encoding="utf-8"?>
<Database>
    <EnglishText>
        <Row Tag="LOC_CHANGE_CAPITAL_BUTTON">
            <Text>Relocate Capital</Text>
        </Row>
        <Row Tag="LOC_CHANGE_CAPITAL_BUTTON_TOOLTIP">
            <Text>Spend [icon:YIELD_DIPLOMACY] Influence to make one of your other settlements your capital.</Text>
        </Row>
        <Row Tag="LOC_CHANGE_CAPITAL_DIALOG_TITLE">
            <Text>Choose a New Capital</Text>
        </Row>
        <Row Tag="LOC_CHANGE_CAPITAL_DIALOG_SUBTITLE">
            <Text>Costs {1_Cost} [icon:YIELD_DIPLOMACY] Influence. You have {2_Balance}.</Text>
        </Row>
        <Row Tag="LOC_CHANGE_CAPITAL_CURRENT_CAPITAL">
            <Text>{1_CityName} (current capital)</Text>
        </Row>
        <Row Tag="LOC_CHANGE_CAPITAL_INSUFFICIENT_FUNDS">
            <Text>Not enough [icon:YIELD_DIPLOMACY] Influence. You need {1_Cost} but only have {2_Balance}.</Text>
        </Row>
        <Row Tag="LOC_CHANGE_CAPITAL_CANNOT_RELOCATE">
            <Text>{1_CityName} cannot become your capital right now.</Text>
        </Row>
        <Row Tag="LOC_CHANGE_CAPITAL_SUCCESS">
            <Text>{1_CityName} is now your capital.</Text>
        </Row>
        <Row Tag="LOC_CHANGE_CAPITAL_NO_OTHER_CITIES">
            <Text>You have no other settlements to make your capital.</Text>
        </Row>
        <Row Tag="LOC_CHANGE_CAPITAL_CLOSE">
            <Text>Cancel</Text>
        </Row>
    </EnglishText>
</Database>
