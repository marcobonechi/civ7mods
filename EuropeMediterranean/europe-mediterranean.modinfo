<?xml version="1.0" encoding="utf-8"?>
<Mod id="europe-mediterranean-map" version="53" xmlns="ModInfo">
    <Properties>
        <Name>Europe, Mediterranean, North Africa</Name>
        <Description>Europe, Mediterranean and Africa above the Equator, both single land and with distant lands of Africa, Iceland, Scandinavia.</Description>
        <Authors>Marco</Authors>
        <Package>Mod</Package>
        <Version>53</Version>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet></AlwaysMet>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="shell-europe-med" scope="shell" criteria="always">
            <Actions>
                <UpdateDatabase>
                    <Item>config/config.xml</Item>
                </UpdateDatabase>
                <UpdateText>
                    <Item>text/en_us/MapText.xml</Item>
                    <Item>l10n/ModuleText.xml</Item>
                    <Item locale="de_DE">l10n/de_DE_Text.xml</Item>
                    <Item locale="es_ES">l10n/es_ES_Text.xml</Item>
                    <Item locale="fr_FR">l10n/fr_FR_Text.xml</Item>
                    <Item locale="it_IT">l10n/it_IT_Text.xml</Item>
                    <Item locale="ja_JP">l10n/ja_JP_Text.xml</Item>
                    <Item locale="ko_KR">l10n/ko_KR_Text.xml</Item>
                    <Item locale="pl_PL">l10n/pl_PL_Text.xml</Item>
                    <Item locale="pt_BR">l10n/pt_BR_Text.xml</Item>
                    <Item locale="uk_UA">l10n/uk_UA_Text.xml</Item>
                    <Item locale="zh_Hans_CN">l10n/zh_Hans_CN_Text.xml</Item>
                    <Item locale="zh_Hant_HK">l10n/zh_Hant_HK_Text.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="game-europe-med" scope="game" criteria="always">
            <Actions>
                <UpdateDatabase>
                    <Item>data/maps.xml</Item>
                </UpdateDatabase>
                <ImportFiles>
                    <Item>maps/europe-alt-geo.js</Item>
                    <Item>maps/europe-alt-map.js</Item>
                    <Item>maps/europe-geo.js</Item>
                    <Item>maps/europe-large-core.js</Item>
                    <Item>maps/europe-large-geo.js</Item>
                    <Item>maps/europe-large-map.js</Item>
                    <Item>maps/europe-large-united-map.js</Item>
                    <Item>maps/europe-map.js</Item>
                    <Item>maps/europe-raster.js</Item>
                </ImportFiles>
                <UpdateText>
                    <Item>text/en_us/MapText.xml</Item>
                    <Item>l10n/ModuleText.xml</Item>
                    <Item locale="de_DE">l10n/de_DE_Text.xml</Item>
                    <Item locale="es_ES">l10n/es_ES_Text.xml</Item>
                    <Item locale="fr_FR">l10n/fr_FR_Text.xml</Item>
                    <Item locale="it_IT">l10n/it_IT_Text.xml</Item>
                    <Item locale="ja_JP">l10n/ja_JP_Text.xml</Item>
                    <Item locale="ko_KR">l10n/ko_KR_Text.xml</Item>
                    <Item locale="pl_PL">l10n/pl_PL_Text.xml</Item>
                    <Item locale="pt_BR">l10n/pt_BR_Text.xml</Item>
                    <Item locale="uk_UA">l10n/uk_UA_Text.xml</Item>
                    <Item locale="zh_Hans_CN">l10n/zh_Hans_CN_Text.xml</Item>
                    <Item locale="zh_Hant_HK">l10n/zh_Hant_HK_Text.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
    </ActionGroups>
    <LocalizedText>
        <Text id="LOC_MODULE_EUROPE_MED_NAME">
            <en_US>Europe, Mediterranean, North Africa</en_US>
            <it_IT>Mappa Europa, Mediterraneo e Nord Africa</it_IT>
            <uk_UA>Мапа Європи, Середземномор'я та Північної Африки</uk_UA>
            <de_DE>Karte Europa, Mittelmeer &amp; Nordafrika</de_DE>
            <fr_FR>Carte Europe, Méditerranée et Afrique du Nord</fr_FR>
            <es_ES>Mapa de Europa, el Mediterráneo y el Norte de África</es_ES>
            <pl_PL>Mapa Europa, Morze Śródziemne i Afryka Północna</pl_PL>
            <pt_BR>Mapa Europa, Mediterrâneo e Norte da África</pt_BR>
            <zh_Hans_CN>欧洲、地中海与北非地图</zh_Hans_CN>
            <zh_Hant_HK>歐洲、地中海與北非地圖</zh_Hant_HK>
            <ja_JP>ヨーロッパ、地中海、北アフリカのマップ</ja_JP>
            <ko_KR>유럽, 지중해 및 북아프리카 지도</ko_KR>
        </Text>
        <Text id="LOC_MODULE_EUROPE_MED_DESCRIPTION">
            <en_US>Europe, Mediterranean and Africa above the Equator, both single land and with distant lands of Africa, Iceland, Scandinavia.</en_US>
            <it_IT>Europa, Mediterraneo e Africa sopra l'Equatore, sia come terra emersa unica che con terre lontane d'Africa, Islanda, Scandinavia.</it_IT>
            <uk_UA>Європа, Середземномор'я та Африка на північ від екватора, як єдиним материком, так і з далекими землями Африки, Ісландії, Скандинавії.</uk_UA>
            <de_DE>Europa, Mittelmeer und Afrika nördlich des Äquators, sowohl als einheitliche Landmasse als auch mit fernen Ländern in Afrika, Island, Skandinavien.</de_DE>
            <fr_FR>Europe, Méditerranée et Afrique au-dessus de l'équateur, à la fois en masse continentale unique et avec les terres lointaines d'Afrique, d'Islande et de Scandinavie.</fr_FR>
            <es_ES>Europa, el Mediterráneo y África por encima del ecuador, tanto como masa continental única como con tierras lejanas de África, Islandia y Escandinavia.</es_ES>
            <pl_PL>Europa, Morze Śródziemne i Afryka na północ od równika, zarówno jako jednolity ląd, jak i z odległymi krainami Afryki, Islandii i Skandynawii.</pl_PL>
            <pt_BR>Europa, Mediterrâneo e África acima do Equador, tanto como massa de terra única quanto com terras distantes da África, Islândia e Escandinávia.</pt_BR>
            <zh_Hans_CN>欧洲、地中海以及赤道以北的非洲，既有单一完整大陆版本，也有包含非洲远方土地、冰岛和斯堪的纳维亚的版本。</zh_Hans_CN>
            <zh_Hant_HK>歐洲、地中海以及赤道以北的非洲，既有單一完整大陸版本，也有包含非洲遙遠土地、冰島和斯堪地那維亞的版本。</zh_Hant_HK>
            <ja_JP>ヨーロッパ、地中海、赤道以北のアフリカ。単一の大陸版と、アフリカ・アイスランド・スカンディナヴィアの遠方土地を含む版の両方を収録。</ja_JP>
            <ko_KR>유럽, 지중해 및 적도 이북의 아프리카. 단일 대륙 버전과 아프리카, 아이슬란드, 스칸디나비아의 먼 땅 버전을 모두 지원합니다.</ko_KR>
        </Text>
        <File>text/en_us/ModuleText.xml</File>
        <File>l10n/ModuleText.xml</File>
    </LocalizedText>
</Mod>
