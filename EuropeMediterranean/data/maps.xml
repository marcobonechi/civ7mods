<?xml version="1.0" encoding="utf-8"?>
<!-- Gameplay-side map sizes for the large map. The engine takes the grid from these rows,
     not from the map script, so each size needs its own MapSizeType. -->
<Database>
    <Types>
        <Replace Type="MAPSIZE_EUROPE_LARGE_LRG" Kind="KIND_MAPSIZE"/>
    </Types>
    <Maps>
        <Replace MapSizeType="MAPSIZE_EUROPE_LARGE_LRG" Name="LOC_MAPSIZE_EUROPE_LARGE_LRG_NAME" Description="LOC_MAPSIZE_EUROPE_LARGE_LRG_DESCRIPTION" DefaultPlayers="12" PlayersLandmass1="7" PlayersLandmass2="5" GridWidth="128" GridHeight="112" NumNaturalWonders="14" OceanWidth="4" LakeSizeCutoff="10" LakeGenerationFrequency="25" Continents="4" StartSectorRows="4" StartSectorCols="3"/>
    </Maps>
    <AgeProgressionEventMapSizeOverrides>
        <Row AgeProgressionEventType="AGE_PROGRESSION_PLAYER_ELIMINATED" MapSizeType="MAPSIZE_EUROPE_LARGE_LRG" Points="0"/>
    </AgeProgressionEventMapSizeOverrides>
</Database>
