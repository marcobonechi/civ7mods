<?xml version="1.0" encoding="utf-8"?>
<!-- Gameplay-side map sizes for the large map. The engine takes the grid from these rows,
     not from the map script, so each size needs its own MapSizeType.

     Player counts: these maps are far bigger than the base game's, which runs about 570
     tiles per player at every size. Even at these counts they stay roomier than that
     (915 / 1024 / 1210), which suits a historical map where the true starts are spread
     from Ethiopia to Iran - but the old 10/12/12 left 1100-1500 tiles each and civs
     rarely met before the Exploration Age.

     The ceiling is the civilization pool, not the map: an Antiquity game needs one
     distinct civ per player and the base game ships 15 (17 with the Etruscans and
     Byzantium mods in this repo). MaxPlayers in config/config.xml goes higher for
     anyone who has more civilizations installed. -->
<Database>
    <Types>
        <Replace Type="MAPSIZE_EUROPE_LARGE_STD" Kind="KIND_MAPSIZE"/>
        <Replace Type="MAPSIZE_EUROPE_LARGE_LRG" Kind="KIND_MAPSIZE"/>
        <Replace Type="MAPSIZE_EUROPE_LARGE_HUGE" Kind="KIND_MAPSIZE"/>
    </Types>
    <Maps>
        <Replace MapSizeType="MAPSIZE_EUROPE_LARGE_STD" Name="LOC_MAPSIZE_EUROPE_LARGE_STD_NAME" Description="LOC_MAPSIZE_EUROPE_LARGE_STD_DESCRIPTION" DefaultPlayers="12" PlayersLandmass1="7" PlayersLandmass2="5" GridWidth="112" GridHeight="98" NumNaturalWonders="12" OceanWidth="4" LakeSizeCutoff="10" LakeGenerationFrequency="25" Continents="4" StartSectorRows="4" StartSectorCols="3"/>
        <Replace MapSizeType="MAPSIZE_EUROPE_LARGE_LRG" Name="LOC_MAPSIZE_EUROPE_LARGE_LRG_NAME" Description="LOC_MAPSIZE_EUROPE_LARGE_LRG_DESCRIPTION" DefaultPlayers="14" PlayersLandmass1="8" PlayersLandmass2="6" GridWidth="128" GridHeight="112" NumNaturalWonders="14" OceanWidth="4" LakeSizeCutoff="10" LakeGenerationFrequency="25" Continents="4" StartSectorRows="4" StartSectorCols="3"/>
        <Replace MapSizeType="MAPSIZE_EUROPE_LARGE_HUGE" Name="LOC_MAPSIZE_EUROPE_LARGE_HUGE_NAME" Description="LOC_MAPSIZE_EUROPE_LARGE_HUGE_DESCRIPTION" DefaultPlayers="15" PlayersLandmass1="8" PlayersLandmass2="7" GridWidth="144" GridHeight="126" NumNaturalWonders="16" OceanWidth="4" LakeSizeCutoff="10" LakeGenerationFrequency="25" Continents="4" StartSectorRows="4" StartSectorCols="3"/>
    </Maps>
    <AgeProgressionEventMapSizeOverrides>
        <Row AgeProgressionEventType="AGE_PROGRESSION_PLAYER_ELIMINATED" MapSizeType="MAPSIZE_EUROPE_LARGE_STD" Points="0"/>
        <Row AgeProgressionEventType="AGE_PROGRESSION_PLAYER_ELIMINATED" MapSizeType="MAPSIZE_EUROPE_LARGE_LRG" Points="0"/>
        <Row AgeProgressionEventType="AGE_PROGRESSION_PLAYER_ELIMINATED" MapSizeType="MAPSIZE_EUROPE_LARGE_HUGE" Points="0"/>
    </AgeProgressionEventMapSizeOverrides>
</Database>
