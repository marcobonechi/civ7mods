<?xml version="1.0" encoding="utf-8"?>
<!-- Gameplay-side map sizes for the large map. The engine takes the grid from these rows,
     not from the map script, so each size needs its own MapSizeType. -->
<Database>
    <Types>
        <Replace Type="MAPSIZE_EUROPE_LARGE_STD" Kind="KIND_MAPSIZE"/>
        <Replace Type="MAPSIZE_EUROPE_LARGE_LRG" Kind="KIND_MAPSIZE"/>
        <Replace Type="MAPSIZE_EUROPE_LARGE_HUGE" Kind="KIND_MAPSIZE"/>
    </Types>
    <Maps>
        <Replace MapSizeType="MAPSIZE_EUROPE_LARGE_STD" Name="LOC_MAPSIZE_EUROPE_LARGE_STD_NAME" Description="LOC_MAPSIZE_EUROPE_LARGE_STD_DESCRIPTION" DefaultPlayers="10" PlayersLandmass1="6" PlayersLandmass2="4" GridWidth="112" GridHeight="98" NumNaturalWonders="8" OceanWidth="4" LakeSizeCutoff="10" LakeGenerationFrequency="25" Continents="4" StartSectorRows="4" StartSectorCols="3"/>
        <Replace MapSizeType="MAPSIZE_EUROPE_LARGE_LRG" Name="LOC_MAPSIZE_EUROPE_LARGE_LRG_NAME" Description="LOC_MAPSIZE_EUROPE_LARGE_LRG_DESCRIPTION" DefaultPlayers="12" PlayersLandmass1="7" PlayersLandmass2="5" GridWidth="128" GridHeight="112" NumNaturalWonders="9" OceanWidth="4" LakeSizeCutoff="10" LakeGenerationFrequency="25" Continents="4" StartSectorRows="4" StartSectorCols="3"/>
        <Replace MapSizeType="MAPSIZE_EUROPE_LARGE_HUGE" Name="LOC_MAPSIZE_EUROPE_LARGE_HUGE_NAME" Description="LOC_MAPSIZE_EUROPE_LARGE_HUGE_DESCRIPTION" DefaultPlayers="12" PlayersLandmass1="7" PlayersLandmass2="5" GridWidth="144" GridHeight="126" NumNaturalWonders="10" OceanWidth="4" LakeSizeCutoff="10" LakeGenerationFrequency="25" Continents="4" StartSectorRows="4" StartSectorCols="3"/>
    </Maps>
    <AgeProgressionEventMapSizeOverrides>
        <Row AgeProgressionEventType="AGE_PROGRESSION_PLAYER_ELIMINATED" MapSizeType="MAPSIZE_EUROPE_LARGE_STD" Points="0"/>
        <Row AgeProgressionEventType="AGE_PROGRESSION_PLAYER_ELIMINATED" MapSizeType="MAPSIZE_EUROPE_LARGE_LRG" Points="0"/>
        <Row AgeProgressionEventType="AGE_PROGRESSION_PLAYER_ELIMINATED" MapSizeType="MAPSIZE_EUROPE_LARGE_HUGE" Points="0"/>
    </AgeProgressionEventMapSizeOverrides>
</Database>
