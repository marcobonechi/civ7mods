<?xml version="1.0" encoding="utf-8"?>
<Database>
    <LocalizedText>
        <Replace Tag="LOC_MAP_EUROPE_MED_NAME" Language="ja_JP">
            <Text>ヨーロッパ、地中海、北アフリカ</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_DESCRIPTION" Language="ja_JP">
            <Text>ウラル山脈からアイスランド、モロッコからシナイ半島に至るヨーロッパ、地中海盆地、北アフリカのマップ。該当地域の文明には史実準拠のスタート地点を用意。他の文明は厳選された地点からスタートします。[n]標準マップサイズに対応。</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_NAME" Language="ja_JP">
            <Text>ヨーロッパ＆地中海（遥かなる地）</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_DESCRIPTION" Language="ja_JP">
            <Text>サヘルまでのヨーロッパ、地中海、北アフリカ。史実の初期位置と、実際の流路どおりの川。アフリカ、スカンディナヴィア、アイスランドは遥かなる地です。</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_UNITED_NAME" Language="ja_JP">
            <Text>ヨーロッパ＆地中海（単一陸塊）</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_UNITED_DESCRIPTION" Language="ja_JP">
            <Text>遥かなる地のない同じマップ。すべての文明に陸路で到達できます。探検の時代の財宝と軍事のレガシーパスはここでは得点できません。</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_STD_NAME" Language="ja_JP">
            <Text>ヨーロッパ 大型 112x98</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_STD_DESCRIPTION" Language="ja_JP">
            <Text>112x98グリッド、デフォルト12人プレイ。</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_LRG_NAME" Language="ja_JP">
            <Text>ヨーロッパ 大型 128x112</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_LRG_DESCRIPTION" Language="ja_JP">
            <Text>128x112グリッド、デフォルト14人プレイ。</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_HUGE_NAME" Language="ja_JP">
            <Text>ヨーロッパ 大型 144x126</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_HUGE_DESCRIPTION" Language="ja_JP">
            <Text>144x126グリッド、デフォルト15人プレイ。古いPCではターンが長くなります。</Text>
        </Replace>
    </LocalizedText>
</Database>
