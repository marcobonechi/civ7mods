<?xml version="1.0" encoding="utf-8"?>
<Database>
    <LocalizedText>
        <Replace Tag="LOC_MAP_EUROPE_MED_NAME" Language="zh_Hant_HK">
            <Text>歐洲、地中海與北非</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_DESCRIPTION" Language="zh_Hant_HK">
            <Text>一張歐洲、地中海盆地與北非地圖，涵蓋從烏拉山脈到冰島、從摩洛哥到西奈半島的區域。該區域文明擁有真實歷史起始位置；其他文明則在精選位置起始。[n]適用於標準地圖尺寸。</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_NAME" Language="zh_Hant_HK">
            <Text>歐洲與地中海（遙遠土地）</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_DESCRIPTION" Language="zh_Hant_HK">
            <Text>歐洲、地中海與北非，南至薩赫爾，擁有歷史出生點，河流沿真實河道流淌。非洲、斯堪地那維亞和冰島為遙遠土地。</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_UNITED_NAME" Language="zh_Hant_HK">
            <Text>歐洲與地中海（單一陸塊）</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_UNITED_DESCRIPTION" Language="zh_Hant_HK">
            <Text>沒有遙遠土地的同一張地圖：所有文明都可經陸路抵達。探索時代的寶藏與軍事傳承之路在此無法得分。</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_STD_NAME" Language="zh_Hant_HK">
            <Text>歐洲大型地圖 112x98</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_STD_DESCRIPTION" Language="zh_Hant_HK">
            <Text>112x98 網格，預設 12 名玩家。</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_LRG_NAME" Language="zh_Hant_HK">
            <Text>歐洲大型地圖 128x112</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_LRG_DESCRIPTION" Language="zh_Hant_HK">
            <Text>128x112 網格，預設 14 名玩家。</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_HUGE_NAME" Language="zh_Hant_HK">
            <Text>歐洲大型地圖 144x126</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_HUGE_DESCRIPTION" Language="zh_Hant_HK">
            <Text>144x126 網格，預設 15 名玩家。舊電腦上回合較慢。</Text>
        </Replace>
    </LocalizedText>
</Database>
