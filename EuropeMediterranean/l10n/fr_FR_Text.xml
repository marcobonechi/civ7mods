<?xml version="1.0" encoding="utf-8"?>
<Database>
    <LocalizedText>
        <Replace Tag="LOC_MAP_EUROPE_MED_NAME" Language="fr_FR">
            <Text>Europe, Méditerranée, Afrique du Nord</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_DESCRIPTION" Language="fr_FR">
            <Text>Une carte de l'Europe, du bassin méditerranéen et de l'Afrique du Nord, de l'Oural à l'Islande et du Maroc au Sinaï. Emplacements de départ historiques pour les civilisations de la région ; les autres civilisations démarrent sur des sites choisis.[n]Compatible avec les tailles de carte standard.</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_NAME" Language="fr_FR">
            <Text>Europe et Méditerranée (Terres lointaines)</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_DESCRIPTION" Language="fr_FR">
            <Text>L'Europe, la Méditerranée et l'Afrique du Nord jusqu'au Sahel, avec des départs historiques et des fleuves là où ils coulent vraiment. L'Afrique, la Scandinavie et l'Islande sont des Terres lointaines.</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_UNITED_NAME" Language="fr_FR">
            <Text>Europe et Méditerranée (Masse continentale unique)</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_UNITED_DESCRIPTION" Language="fr_FR">
            <Text>La même carte sans Terres lointaines : chaque civilisation est accessible par voie terrestre. Les voies d'héritage du trésor et militaire de l'Âge de l'Exploration ne rapportent aucun point ici.</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_ALT_NAME" Language="fr_FR">
            <Text>Europe et Méditerranée (Variante)</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_ALT_DESCRIPTION" Language="fr_FR">
            <Text>Une copie séparée de la carte, à remodeler dans l'éditeur sans toucher aux deux autres.</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_STD_NAME" Language="fr_FR">
            <Text>Europe Grande 112x98</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_STD_DESCRIPTION" Language="fr_FR">
            <Text>Grille de 112x98, 12 joueurs par défaut.</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_LRG_NAME" Language="fr_FR">
            <Text>Europe Grande 128x112</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_LRG_DESCRIPTION" Language="fr_FR">
            <Text>Grille de 128x112, 14 joueurs par défaut.</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_HUGE_NAME" Language="fr_FR">
            <Text>Europe Grande 144x126</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_HUGE_DESCRIPTION" Language="fr_FR">
            <Text>Grille de 144x126, 15 joueurs par défaut. Tours lents sur les machines anciennes.</Text>
        </Replace>
    </LocalizedText>
</Database>
