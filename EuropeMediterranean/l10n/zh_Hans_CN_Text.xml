<?xml version="1.0" encoding="utf-8"?>
<Database>
    <LocalizedText>
        <Replace Tag="LOC_MAP_EUROPE_MED_NAME" Language="zh_Hans_CN">
            <Text>欧洲、地中海与北非</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_DESCRIPTION" Language="zh_Hans_CN">
            <Text>一张欧洲、地中海盆地与北非地图，涵盖从乌拉尔山脉到冰岛、从摩洛哥到西奈半岛的区域。本区域文明拥有史实起始位置；其他文明则在精选位置起始。[n]适用于标准地图尺寸。</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_NAME" Language="zh_Hans_CN">
            <Text>欧洲与地中海（远方土地）</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_DESCRIPTION" Language="zh_Hans_CN">
            <Text>欧洲、地中海与北非，南至萨赫勒，拥有历史出生点，河流沿真实河道流淌。非洲、斯堪的纳维亚和冰岛为远方土地。</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_UNITED_NAME" Language="zh_Hans_CN">
            <Text>欧洲与地中海（单一大陆）</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_UNITED_DESCRIPTION" Language="zh_Hans_CN">
            <Text>没有远方土地的同一张地图：所有文明都可经陆路抵达。探索时代的宝藏与军事传承之路在此无法得分。</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_ALT_NAME" Language="zh_Hans_CN">
            <Text>压缩欧亚大陆</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_ALT_DESCRIPTION" Language="zh_Hans_CN">
            <Text>地图的独立副本，可在编辑器中改造，不影响另外两张地图。</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_STD_NAME" Language="zh_Hans_CN">
            <Text>欧洲大地图 112x98</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_STD_DESCRIPTION" Language="zh_Hans_CN">
            <Text>112x98 网格，默认 12 名玩家。</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_LRG_NAME" Language="zh_Hans_CN">
            <Text>欧洲大地图 128x112</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_LRG_DESCRIPTION" Language="zh_Hans_CN">
            <Text>128x112 网格，默认 14 名玩家。</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_HUGE_NAME" Language="zh_Hans_CN">
            <Text>欧洲大地图 144x126</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_HUGE_DESCRIPTION" Language="zh_Hans_CN">
            <Text>144x126 网格，默认 15 名玩家。老旧电脑上回合较慢。</Text>
        </Replace>
    </LocalizedText>
</Database>
