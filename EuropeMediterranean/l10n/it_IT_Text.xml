<?xml version="1.0" encoding="utf-8"?>
<Database>
    <LocalizedText>
        <Replace Tag="LOC_MAP_EUROPE_MED_NAME" Language="it_IT">
            <Text>Europa, Mediterraneo, Nord Africa</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_DESCRIPTION" Language="it_IT">
            <Text>Una mappa dell'Europa, del bacino del Mediterraneo e del Nord Africa, dagli Urali all'Islanda e dal Marocco al Sinai. Posizioni di partenza storiche per le civiltà della regione; le altre civiltà partono da posizioni selezionate.[n]Compatibile con le dimensioni standard della mappa.</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_NAME" Language="it_IT">
            <Text>Europa e Mediterraneo (Terre lontane)</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_DESCRIPTION" Language="it_IT">
            <Text>Europa, Mediterraneo e Nord Africa fino al Sahel, con partenze storiche e fiumi dove scorrono davvero. Africa, Scandinavia e Islanda sono Terre lontane.</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_UNITED_NAME" Language="it_IT">
            <Text>Europa e Mediterraneo (Massa continentale unica)</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_UNITED_DESCRIPTION" Language="it_IT">
            <Text>La stessa mappa senza Terre lontane: ogni civiltà è raggiungibile via terra. I percorsi eredità del tesoro e militare dell'Era delle Esplorazioni qui non danno punti.</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_ALT_NAME" Language="it_IT">
            <Text>Europa e Mediterraneo (Variante)</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_ALT_DESCRIPTION" Language="it_IT">
            <Text>Una copia separata della mappa, da rimodellare nell'editor senza toccare le altre due.</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_STD_NAME" Language="it_IT">
            <Text>Europa grande 112x98</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_STD_DESCRIPTION" Language="it_IT">
            <Text>Griglia 112x98, 12 giocatori predefiniti.</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_LRG_NAME" Language="it_IT">
            <Text>Europa grande 128x112</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_LRG_DESCRIPTION" Language="it_IT">
            <Text>Griglia 128x112, 14 giocatori predefiniti.</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_HUGE_NAME" Language="it_IT">
            <Text>Europa grande 144x126</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_HUGE_DESCRIPTION" Language="it_IT">
            <Text>Griglia 144x126, 15 giocatori predefiniti. Turni lenti sui computer meno recenti.</Text>
        </Replace>
    </LocalizedText>
</Database>
