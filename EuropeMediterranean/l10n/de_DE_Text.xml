<?xml version="1.0" encoding="utf-8"?>
<Database>
    <LocalizedText>
        <Replace Tag="LOC_MAP_EUROPE_MED_NAME" Language="de_DE">
            <Text>Europa, Mittelmeer, Nordafrika</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_DESCRIPTION" Language="de_DE">
            <Text>Eine Karte von Europa, dem Mittelmeerraum und Nordafrika, vom Ural bis nach Island und von Marokko bis zum Sinai. Historische Startpositionen für Zivilisationen aus dieser Region; andere Zivilisationen starten an ausgewählten Orten.[n]Kompatibel mit Standard-Kartengrößen.</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_NAME" Language="de_DE">
            <Text>Europa &amp; Mittelmeer (Ferne Länder)</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_DESCRIPTION" Language="de_DE">
            <Text>Europa, der Mittelmeerraum und Nordafrika bis zum Sahel, mit historischen Startpositionen und Flüssen dort, wo sie wirklich fließen. Afrika, Skandinavien und Island sind Ferne Länder.</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_UNITED_NAME" Language="de_DE">
            <Text>Europa &amp; Mittelmeer (Eine Landmasse)</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_MED_LARGE_UNITED_DESCRIPTION" Language="de_DE">
            <Text>Dieselbe Karte ohne Ferne Länder: Jede Zivilisation ist über Land erreichbar. Die Schatz- und Militär-Vermächtnispfade des Zeitalters der Erkundung bringen hier keine Punkte.</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_ALT_NAME" Language="de_DE">
            <Text>Eurasien komprimiert</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_ALT_DESCRIPTION" Language="de_DE">
            <Text>Europa, das Mittelmeer und Afrika; Russland und das Kaspische Meer sind ein Östlicher Ozean, dahinter China, Korea, die Mongolei und Japan. Keine fernen Länder.</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_ALT_DISTANT_NAME" Language="de_DE">
            <Text>Eurasien komprimiert (Ferne Länder)</Text>
        </Replace>
        <Replace Tag="LOC_MAP_EUROPE_ALT_DISTANT_DESCRIPTION" Language="de_DE">
            <Text>Dieselbe Karte, mit Ostasien, Skandinavien und Island als ferne Länder jenseits des Wassers.</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_STD_NAME" Language="de_DE">
            <Text>Europa Groß 112x98</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_STD_DESCRIPTION" Language="de_DE">
            <Text>112x98-Raster, standardmäßig 12 Spieler.</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_LRG_NAME" Language="de_DE">
            <Text>Europa Groß 128x112</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_LRG_DESCRIPTION" Language="de_DE">
            <Text>128x112-Raster, standardmäßig 14 Spieler.</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_HUGE_NAME" Language="de_DE">
            <Text>Europa Groß 144x126</Text>
        </Replace>
        <Replace Tag="LOC_MAPSIZE_EUROPE_LARGE_HUGE_DESCRIPTION" Language="de_DE">
            <Text>144x126-Raster, standardmäßig 15 Spieler. Lange Züge auf älteren Rechnern.</Text>
        </Replace>
    </LocalizedText>
