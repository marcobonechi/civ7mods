<?xml version="1.0" encoding="utf-8"?>
<GameEffects xmlns="GameEffects">
    <!-- The Piazza: the square the bank and the workshop face onto. Every Settlement in the
         republic gains from one (the Mese/Spura pattern). -->
    <Modifier id="MOD_TUSCANY_PIAZZA_GOLD_PER_SETTLEMENT" collection="COLLECTION_ALL_CITIES" effect="EFFECT_CITY_ADJUST_YIELD_PER_NUM_CITIES">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_CITY_HAS_UNIQUE_QUARTER">
                <Argument name="UniqueQuarterType">QUARTER_PIAZZA</Argument>
            </Requirement>
        </SubjectRequirements>
        <Argument name="YieldType">YIELD_GOLD</Argument>
        <Argument name="Amount">1</Argument>
        <Argument name="Cities">true</Argument>
        <Argument name="Towns">true</Argument>
        <Argument name="Tooltip">LOC_QUARTER_PIAZZA_NAME</Argument>
    </Modifier>
    <Modifier id="MOD_TUSCANY_PIAZZA_CULTURE_PER_SETTLEMENT" collection="COLLECTION_ALL_CITIES" effect="EFFECT_CITY_ADJUST_YIELD_PER_NUM_CITIES">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_CITY_HAS_UNIQUE_QUARTER">
                <Argument name="UniqueQuarterType">QUARTER_PIAZZA</Argument>
            </Requirement>
        </SubjectRequirements>
        <Argument name="YieldType">YIELD_CULTURE</Argument>
        <Argument name="Amount">1</Argument>
        <Argument name="Cities">true</Argument>
        <Argument name="Towns">true</Argument>
        <Argument name="Tooltip">LOC_QUARTER_PIAZZA_NAME</Argument>
    </Modifier>
    <Modifier id="MOD_TUSCANY_PIAZZA_HAPPINESS_PER_GREAT_WORK" collection="COLLECTION_ALL_CITIES" effect="EFFECT_CITY_ADJUST_YIELD_PER_GREAT_WORK">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_CITY_HAS_UNIQUE_QUARTER">
                <Argument name="UniqueQuarterType">QUARTER_PIAZZA</Argument>
            </Requirement>
        </SubjectRequirements>
        <Argument name="YieldType">YIELD_HAPPINESS</Argument>
        <Argument name="Amount">2</Argument>
        <Argument name="Tooltip">LOC_QUARTER_PIAZZA_NAME</Argument>
    </Modifier>
    <!-- The Bottega is where the work is made, so it is paid for every work on show. -->
    <Modifier id="MOD_TUSCANY_BOTTEGA_CULTURE_PER_GREAT_WORK" collection="COLLECTION_OWNER" effect="EFFECT_CITY_ADJUST_YIELD_PER_GREAT_WORK">
        <Argument name="YieldType">YIELD_GOLD</Argument>
        <Argument name="Amount">1</Argument>
        <Argument name="Tooltip">LOC_BUILDING_BOTTEGA_NAME</Argument>
    </Modifier>
    <!-- Santa Maria del Fiore: a Relic when the dome closes (Rila Monastery shape, once). -->
    <Modifier id="MOD_SANTA_MARIA_DEL_FIORE_RELIC" collection="COLLECTION_OWNER" effect="EFFECT_GRANT_GREAT_WORK" run-once="true" permanent="true">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_WONDER_IS_ACTIVE">
                <Argument name="ConstructibleType">WONDER_SANTA_MARIA_DEL_FIORE</Argument>
            </Requirement>
        </SubjectRequirements>
        <Argument name="GreatWorkType">GREATWORK_RELIC</Argument>
        <Argument name="Amount">1</Argument>
    </Modifier>
    <!-- Rinascimento: +45% Production toward Santa Maria del Fiore. -->
    <Modifier id="MOD_CIV_WONDER_PRODUCTION_TUSCANY" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_FAVORED_WONDER_PRODUCTION">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_PLAYER_HAS_CIVILIZATION_OR_LEADER_TRAIT">
                <Argument name="TraitType">TRAIT_TUSCANY</Argument>
            </Requirement>
        </SubjectRequirements>
        <Argument name="Percent">45</Argument>
        <String context="Preview">LOC_MOD_CIV_WONDER_PRODUCTION_TUSCANY_DESCRIPTION</String>
    </Modifier>
</GameEffects>
