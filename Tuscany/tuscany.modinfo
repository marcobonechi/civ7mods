<?xml version="1.0" encoding="utf-8"?>
<Mod id="tuscany" version="1" xmlns="ModInfo">
    <Properties>
        <Name>LOC_MODULE_TUSCANY_NAME</Name>
        <Description>LOC_MODULE_TUSCANY_DESCRIPTION</Description>
        <Authors>Marco</Authors>
        <Package>Mod</Package>
        <Version>1</Version>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
    </Dependencies>
    <References>
        <Mod id="age-exploration" title="LOC_MODULE_AGE_EXPLORATION_NAME"/>
    </References>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet></AlwaysMet>
        </Criteria>
        <Criteria id="antiquity-age-current">
            <AgeInUse>AGE_ANTIQUITY</AgeInUse>
        </Criteria>
        <Criteria id="exploration-age-current">
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
        </Criteria>
        <Criteria id="modern-age-current">
            <AgeInUse>AGE_MODERN</AgeInUse>
        </Criteria>
        <Criteria id="exploration-age-persist" any="true">
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
            <AgeInUse>AGE_MODERN</AgeInUse>
        </Criteria>
        <Criteria id="etruscans-current">
            <ModInUse>etruscans</ModInUse>
        </Criteria>
        <Criteria id="etruscans-shell">
            <ModIsEnabled>etruscans</ModIsEnabled>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="tuscany-art" scope="game" criteria="always">
            <Actions>
                <ImportFiles>
                    <Item>icons/civ_sym_tuscany.png</Item>
                    <Item>icons/unitflag_condottiero.png</Item>
                    <Item>icons/unitflag_galea_santo_stefano.png</Item>
                    <Item>icons/unitflag_maestro.png</Item>
                    <Item>icons/buildicon_bottega.png</Item>
                    <Item>icons/buildicon_banco.png</Item>
                    <Item>icons/wondericon_santa_maria_del_fiore.png</Item>
                    <Item>icons/leader_lorenzo.png</Item>
                    <Item>icons/lp_circ_lorenzo_256.png</Item>
                    <Item>icons/lp_hex_lorenzo_256.png</Item>
                    <Item>icons/lsl_lorenzo.png</Item>
                    <Item>icons/lsbg_tuscany_1080.png</Item>
                    <Item>icons/lsbg_tuscany_720.png</Item>
                    <Item>icons/lsbg_tuscany_vert.png</Item>
                    <Item>icons/bg-panel-tuscany.png</Item>
                    <Item>icons/bg-card-tuscany.png</Item>
                </ImportFiles>
                <UpdateIcons>
                    <Item>data/icons/icons.xml</Item>
                </UpdateIcons>
                <UpdateVisualRemaps>
                    <Item>data/visual-remaps.xml</Item>
                </UpdateVisualRemaps>
                <UIScripts>
                    <Item>ui/tuscany-images.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
        <ActionGroup id="tuscany-text" scope="game" criteria="always">
            <Actions>
                <UpdateText>
                    <Item>text/en_us/CitizenNamesText.xml</Item>
                    <Item>text/en_us/CityNamesText.xml</Item>
                    <Item>text/en_us/CivilizationLegacyText.xml</Item>
                    <Item>text/en_us/CivilizationText.xml</Item>
                    <Item>text/en_us/CivilopediaText.xml</Item>
                    <Item>text/en_us/ConstructibleText.xml</Item>
                    <Item>text/en_us/CultureText.xml</Item>
                    <Item>text/en_us/LeaderText.xml</Item>
                    <Item>text/en_us/LoadingText.xml</Item>
                    <Item>text/en_us/ModuleText.xml</Item>
                    <Item>text/en_us/UnitText.xml</Item>
                    <Item>text/en_us/UnlockText.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="tuscany-main" scope="game" criteria="always">
            <Properties>
                <LoadOrder>1</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/civilizations-legacy.xml</Item>
                    <Item>data/civilizations-shared.xml</Item>
                    <Item>data/civilizations-shared-gameeffects.xml</Item>
                    <Item>data/leaders.xml</Item>
                    <Item>data/leaders-gameeffects.xml</Item>
                    <Item>data/traditions.xml</Item>
                    <Item>data/traditions-gameeffects.xml</Item>
                    <Item>data/unlocks-base-standard.xml</Item>
                    <Item>data/unlocks-exploration.xml</Item>
                    <Item>data/unlocks-syncretism.xml</Item>
                    <Item>data/citizen-names.xml</Item>
                    <Item>data/loading-info.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <!-- The quarter and the wonder come before the units and the Maestro, which name them:
             a file with one unresolved foreign key is dropped whole. -->
        <ActionGroup id="tuscany-exploration-persist" scope="game" criteria="exploration-age-persist">
            <Properties>
                <LoadOrder>5</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/constructibles.xml</Item>
                    <Item>data/constructibles-gameeffects.xml</Item>
                    <Item>data/greatworks.xml</Item>
                    <Item>data/traditions-persist.xml</Item>
                    <Item>data/traditions-gameeffects-persist.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="tuscany-exploration" scope="game" criteria="exploration-age-current">
            <Properties>
                <LoadOrder>10</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/civilizations-exploration.xml</Item>
                    <Item>data/civilizations-gameeffects.xml</Item>
                    <Item>data/narrative-display.xml</Item>
                    <Item>data/progression-trees-culture-unique.xml</Item>
                    <Item>data/units.xml</Item>
                    <Item>data/units-gameeffects.xml</Item>
                    <Item>data/greatpeople-gameeffects.xml</Item>
                    <Item>data/greatpeople.xml</Item>
                    <Item>data/progression-trees-tech.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="tuscany-antiquity" scope="game" criteria="antiquity-age-current">
            <Properties>
                <LoadOrder>10</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/civilizations-antiquity.xml</Item>
                    <Item>data/progression-trees-culture-unique-aq.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="tuscany-modern" scope="game" criteria="modern-age-current">
            <Properties>
                <LoadOrder>10</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/civilizations-modern.xml</Item>
                    <Item>data/progression-trees-culture-unique-mo.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="tuscany-etruscans" scope="game" criteria="etruscans-current">
            <Properties>
                <LoadOrder>20</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/unlocks-etruscans.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="tuscany-shell" scope="shell" criteria="always">
            <Actions>
                <ImportFiles>
                    <Item>icons/civ_sym_tuscany.png</Item>
                    <Item>icons/unitflag_condottiero.png</Item>
                    <Item>icons/unitflag_galea_santo_stefano.png</Item>
                    <Item>icons/unitflag_maestro.png</Item>
                    <Item>icons/buildicon_bottega.png</Item>
                    <Item>icons/buildicon_banco.png</Item>
                    <Item>icons/wondericon_santa_maria_del_fiore.png</Item>
                    <Item>icons/leader_lorenzo.png</Item>
                    <Item>icons/lp_circ_lorenzo_256.png</Item>
                    <Item>icons/lp_hex_lorenzo_256.png</Item>
                    <Item>icons/lsl_lorenzo.png</Item>
                    <Item>icons/lsbg_tuscany_1080.png</Item>
                    <Item>icons/lsbg_tuscany_720.png</Item>
                    <Item>icons/lsbg_tuscany_vert.png</Item>
                    <Item>icons/bg-panel-tuscany.png</Item>
                    <Item>icons/bg-card-tuscany.png</Item>
                </ImportFiles>
                <UpdateIcons>
                    <Item>data/icons/icons.xml</Item>
                </UpdateIcons>
                <UpdateVisualRemaps>
                    <Item>data/visual-remaps.xml</Item>
                </UpdateVisualRemaps>
                <UIScripts>
                    <Item>ui/tuscany-images.js</Item>
                </UIScripts>
                <UpdateDatabase>
                    <Item>config/config.xml</Item>
                    <Item>config/config-leader.xml</Item>
                    <Item>config/config-traditions.xml</Item>
                    <Item>data/unlocks-syncretism.xml</Item>
                </UpdateDatabase>
                <UpdateText>
                    <Item>text/en_us/CivilizationLegacyText.xml</Item>
                    <Item>text/en_us/CivilizationText.xml</Item>
                    <Item>text/en_us/ConstructibleText.xml</Item>
                    <Item>text/en_us/CultureText.xml</Item>
                    <Item>text/en_us/LeaderText.xml</Item>
                    <Item>text/en_us/LoadingText.xml</Item>
                    <Item>text/en_us/ModuleText.xml</Item>
                    <Item>text/en_us/UnitText.xml</Item>
                    <Item>text/en_us/UnlockText.xml</Item>
                    <Item>text/en_us/CivilopediaText.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="tuscany-shell-etruscans" scope="shell" criteria="etruscans-shell">
            <Properties>
                <LoadOrder>20</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>config/config-etruscans.xml</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
    </ActionGroups>
    <LocalizedText>
        <File>text/en_us/ModuleText.xml</File>
    </LocalizedText>
</Mod>
