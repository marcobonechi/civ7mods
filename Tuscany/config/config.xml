<?xml version="1.0" encoding="utf-8"?>
<!-- Shell (game setup) side of Tuscany. One Civilizations row, in the Exploration domain only:
     Tuscany belongs to its own age and is not Time-Tested, so there is no Antiquity or Modern
     row and no "Tuscany (Time-Tested)" name. -->
<Database>
    <Civilizations>
        <Row Domain="ExplorationAgeCivilizations" CivilizationType="CIVILIZATION_TUSCANY" CivilizationName="LOC_CIVILIZATION_TUSCANY_NAME" CivilizationFullName="LOC_CIVILIZATION_TUSCANY_FULLNAME" CivilizationDescription="LOC_CIVILIZATION_TUSCANY_DESCRIPTION" CivilizationIcon="CIVILIZATION_TUSCANY" CivilizationIntroText="LOC_LOADING_CIV_INTRO_TEXT_TUSCANY"/>
    </Civilizations>
    <CivilizationItems>
        <Row CivilizationDomain="ExplorationAgeCivilizations" AgeType="AGE_EXPLORATION" CivilizationType="CIVILIZATION_TUSCANY" Type="TRAIT_TUSCANY_ABILITY" Kind="KIND_TRAIT" Name="LOC_TRAIT_TUSCANY_ABILITY_NAME" Description="LOC_TRAIT_TUSCANY_ABILITY_DESCRIPTION"/>
        <Row CivilizationDomain="ExplorationAgeCivilizations" CivilizationType="CIVILIZATION_TUSCANY" Type="UNIT_MAESTRO" Kind="KIND_UNIT" Name="LOC_UNIT_MAESTRO_NAME" Description="LOC_UNIT_MAESTRO_DESCRIPTION" Icon="UNIT_MAESTRO"/>
        <Row CivilizationDomain="ExplorationAgeCivilizations" CivilizationType="CIVILIZATION_TUSCANY" Type="UNIT_CONDOTTIERO" Kind="KIND_UNIT" Name="LOC_UNIT_CONDOTTIERO_NAME" Description="LOC_UNIT_CONDOTTIERO_BASE_DESCRIPTION" Icon="UNIT_CONDOTTIERO"/>
        <Row CivilizationDomain="ExplorationAgeCivilizations" CivilizationType="CIVILIZATION_TUSCANY" Type="UNIT_GALEA_SANTO_STEFANO" Kind="KIND_UNIT" Name="LOC_UNIT_GALEA_SANTO_STEFANO_NAME" Description="LOC_UNIT_GALEA_SANTO_STEFANO_DESCRIPTION" Icon="UNIT_GALEA_SANTO_STEFANO"/>
        <Row CivilizationDomain="ExplorationAgeCivilizations" CivilizationType="CIVILIZATION_TUSCANY" Type="QUARTER_PIAZZA" Kind="KIND_QUARTER" Name="LOC_QUARTER_PIAZZA_NAME" Description="LOC_QUARTER_PIAZZA_DESCRIPTION" Icon="city_uniquequarter"/>
        <Row CivilizationDomain="ExplorationAgeCivilizations" CivilizationType="CIVILIZATION_TUSCANY" Type="BUILDING_BOTTEGA" Kind="KIND_BUILDING" Name="LOC_BUILDING_BOTTEGA_NAME" Description="LOC_BUILDING_BOTTEGA_DESCRIPTION" Icon="BUILDING_BOTTEGA"/>
        <Row CivilizationDomain="ExplorationAgeCivilizations" CivilizationType="CIVILIZATION_TUSCANY" Type="BUILDING_BANCO" Kind="KIND_BUILDING" Name="LOC_BUILDING_BANCO_NAME" Description="LOC_BUILDING_BANCO_DESCRIPTION" Icon="BUILDING_BANCO"/>
    </CivilizationItems>
    <CivilizationTags>
        <Row CivilizationDomain="ExplorationAgeCivilizations" CivilizationType="CIVILIZATION_TUSCANY" TagType="TAG_TRAIT_ECONOMIC"/>
        <Row CivilizationDomain="ExplorationAgeCivilizations" CivilizationType="CIVILIZATION_TUSCANY" TagType="TAG_TRAIT_CULTURAL"/>
        <Row CivilizationDomain="ExplorationAgeCivilizations" CivilizationType="CIVILIZATION_TUSCANY" TagType="TAG_APEX_AGE_EXPLORATION"/>
    </CivilizationTags>
    <CivilizationUnlocks>
        <!-- Antiquity civs that lead to Tuscany. The Etruscans are added by the Etruscans mod.
             CivilizationDomain here is the *unlocking* civ's domain, not Tuscany's: these are
             paths into Tuscany and stay even though Tuscany itself is Exploration-only. -->
        <Row CivilizationDomain="AntiquityAgeCivilizations" CivilizationType="CIVILIZATION_ROME" AgeDomain="StandardAges" AgeType="AGE_EXPLORATION" Type="CIVILIZATION_TUSCANY" Kind="KIND_CIVILIZATION" Name="LOC_CIVILIZATION_TUSCANY_NAME" Description="LOC_CIVILIZATION_TUSCANY_DESCRIPTION" Icon="CIVILIZATION_TUSCANY"/>
        <Row CivilizationDomain="AntiquityAgeCivilizations" CivilizationType="CIVILIZATION_GREECE" AgeDomain="StandardAges" AgeType="AGE_EXPLORATION" Type="CIVILIZATION_TUSCANY" Kind="KIND_CIVILIZATION" Name="LOC_CIVILIZATION_TUSCANY_NAME" Description="LOC_CIVILIZATION_TUSCANY_DESCRIPTION" Icon="CIVILIZATION_TUSCANY"/>
        <!-- Modern civs Tuscany leads to. -->
        <Row CivilizationDomain="ExplorationAgeCivilizations" CivilizationType="CIVILIZATION_TUSCANY" AgeDomain="StandardAges" AgeType="AGE_MODERN" Type="CIVILIZATION_AMERICA" Kind="KIND_CIVILIZATION" Name="LOC_CIVILIZATION_AMERICA_NAME" Description="LOC_CIVILIZATION_AMERICA_DESCRIPTION" Icon="CIVILIZATION_AMERICA"/>
        <Row CivilizationDomain="ExplorationAgeCivilizations" CivilizationType="CIVILIZATION_TUSCANY" AgeDomain="StandardAges" AgeType="AGE_MODERN" Type="CIVILIZATION_FRENCH_EMPIRE" Kind="KIND_CIVILIZATION" Name="LOC_CIVILIZATION_FRENCH_EMPIRE_NAME" Description="LOC_CIVILIZATION_FRENCH_EMPIRE_DESCRIPTION" Icon="CIVILIZATION_FRENCH_EMPIRE"/>
    </CivilizationUnlocks>
    <LeaderUnlocks>
        <!-- Lorenzo is Tuscany's own leader and was missing here, while three borrowed leaders
             were present: the age-transition screen reads this table to decide who has unlocked
             what, so a Lorenzo game reached the Exploration Age with Tuscany still locked. -->
        <Row LeaderDomain="StandardLeaders" LeaderType="LEADER_LORENZO" AgeDomain="StandardAges" AgeType="AGE_EXPLORATION" Type="CIVILIZATION_TUSCANY" Kind="KIND_CIVILIZATION" Name="LOC_CIVILIZATION_TUSCANY_NAME" Description="LOC_CIVILIZATION_TUSCANY_DESCRIPTION" Icon="CIVILIZATION_TUSCANY"/>
        <Row LeaderDomain="StandardLeaders" LeaderType="LEADER_MACHIAVELLI" AgeDomain="StandardAges" AgeType="AGE_EXPLORATION" Type="CIVILIZATION_TUSCANY" Kind="KIND_CIVILIZATION" Name="LOC_CIVILIZATION_TUSCANY_NAME" Description="LOC_CIVILIZATION_TUSCANY_DESCRIPTION" Icon="CIVILIZATION_TUSCANY"/>
        <Row LeaderDomain="StandardLeaders" LeaderType="LEADER_ISABELLA" AgeDomain="StandardAges" AgeType="AGE_EXPLORATION" Type="CIVILIZATION_TUSCANY" Kind="KIND_CIVILIZATION" Name="LOC_CIVILIZATION_TUSCANY_NAME" Description="LOC_CIVILIZATION_TUSCANY_DESCRIPTION" Icon="CIVILIZATION_TUSCANY"/>
        <Row LeaderDomain="StandardLeaders" LeaderType="LEADER_IBN_BATTUTA" AgeDomain="StandardAges" AgeType="AGE_EXPLORATION" Type="CIVILIZATION_TUSCANY" Kind="KIND_CIVILIZATION" Name="LOC_CIVILIZATION_TUSCANY_NAME" Description="LOC_CIVILIZATION_TUSCANY_DESCRIPTION" Icon="CIVILIZATION_TUSCANY"/>
    </LeaderUnlocks>
    <LeaderCivilizationBias>
        <Row CivilizationDomain="ExplorationAgeCivilizations" CivilizationType="CIVILIZATION_TUSCANY" LeaderDomain="StandardLeaders" LeaderType="LEADER_LORENZO" Bias="3" ReasonType="LOC_UNLOCK_PLAY_AS_LORENZO_TUSCANY_TOOLTIP" ChoiceType="LOC_CREATE_GAME_HISTORICAL_CHOICE"/>
        <Row CivilizationDomain="ExplorationAgeCivilizations" CivilizationType="CIVILIZATION_TUSCANY" LeaderDomain="StandardLeaders" LeaderType="LEADER_MACHIAVELLI" Bias="3" ReasonType="LOC_UNLOCK_PLAY_AS_MACHIAVELLI_TUSCANY_TOOLTIP" ChoiceType="LOC_CREATE_GAME_HISTORICAL_CHOICE"/>
        <Row CivilizationDomain="ExplorationAgeCivilizations" CivilizationType="CIVILIZATION_TUSCANY" LeaderDomain="StandardLeaders" LeaderType="LEADER_ISABELLA" Bias="1" ReasonType="LOC_UNLOCK_PLAY_AS_ISABELLA_TUSCANY_TOOLTIP" ChoiceType="LOC_CREATE_GAME_STRATEGIC_CHOICE"/>
        <Row CivilizationDomain="ExplorationAgeCivilizations" CivilizationType="CIVILIZATION_TUSCANY" LeaderDomain="StandardLeaders" LeaderType="LEADER_IBN_BATTUTA" Bias="1" ReasonType="LOC_UNLOCK_PLAY_AS_IBN_BATTUTA_TUSCANY_TOOLTIP" ChoiceType="LOC_CREATE_GAME_GEOGRAPHIC_CHOICE"/>
    </LeaderCivilizationBias>
</Database>
